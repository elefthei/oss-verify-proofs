; The toy binaries are not stored: these rules write them from ../make_elf.py
; and refuse each unless its SHA-256 is the one recorded beside it.
(rule
 (targets exit0.plain)
 (deps (:gen ../make_elf.py) exit0.plain.sha256)
 (action
  (progn
   (run python3 %{gen} exit0 exit0.plain)
   (run sha256sum --check --strict --quiet exit0.plain.sha256))))

(rule
 (targets exit0.padded)
 (deps (:gen ../make_elf.py) exit0.padded.sha256)
 (action
  (progn
   (run python3 %{gen} exit0_nop exit0.padded)
   (run sha256sum --check --strict --quiet exit0.padded.sha256))))
