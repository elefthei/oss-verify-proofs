Template for projects/<project>/<harness>/images/dune.

@@ file
; generated by oft generate from ../harness.yaml; do not edit.
; One rule per build: elf-snapshot turns the ELF that harness.yaml pins into a
; memory image.  The outputs exist only under _build/ and are never stored.
$rules
@@ rule
(rule
 (targets $targets)
 (deps (:elf %{project_root}/$elf))
 (action
  (run elf-snapshot %{elf} $module.v --prefix $module --module-name M
       --namespace $namespace)))
